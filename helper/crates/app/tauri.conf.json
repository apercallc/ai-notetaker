{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Notetaker",
  "version": "0.1.0",
  "identifier": "com.ainotetaker.helper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../native-messaging-host-manifest/com.ainotetaker.helper.json.template": "native-messaging-host-template.json",
      "resources/windows/install-native-messaging.ps1": "windows/install-native-messaging.ps1",
      "resources/windows/uninstall-native-messaging.ps1": "windows/uninstall-native-messaging.ps1"
    },
    "linux": {
      "deb": {
        "postInstallScript": "scripts/debian/postinst",
        "postRemoveScript": "scripts/debian/postrm"
      }
    },
    "macOS": {
      "files": {
        "scripts/macos/install-native-messaging.sh": "Resources/scripts/install-native-messaging.sh",
        "scripts/macos/uninstall-native-messaging.sh": "Resources/scripts/uninstall-native-messaging.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_OWNER_GENERATED_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://updates.example.invalid/ai-notetaker/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
