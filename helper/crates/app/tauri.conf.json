{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Notetaker",
  "version": "0.21.1",
  "identifier": "com.ainotetaker.helper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Notetaker",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../native-messaging-host-manifest/com.ainotetaker.helper.json.template": "native-messaging-host-template.json"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "librsvg2-2",
          "pulseaudio-utils"
        ],
        "desktopTemplate": "scripts/debian/main.desktop",
        "postInstallScript": "scripts/debian/postinst",
        "postRemoveScript": "scripts/debian/postrm"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/scripts/install-native-messaging.sh": "scripts/macos/install-native-messaging.sh",
        "Resources/scripts/uninstall-native-messaging.sh": "scripts/macos/uninstall-native-messaging.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QTEyRDdCMjE2NzI5NUYKUldSZktXY2hleTJobEprem9QTFl6b0JlOG1xTXU3dUZaYUJsK1Q2UmRSOEJkQ1hydFJOWFVuZ1gK",
      "endpoints": [
        "https://github.com/apercallc/ai-notetaker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
