{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Notetaker",
  "version": "0.18.2",
  "identifier": "com.ainotetaker.helper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Notetaker",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../native-messaging-host-manifest/com.ainotetaker.helper.json.template": "native-messaging-host-template.json",
      "resources/windows": "windows"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "librsvg2-2",
          "pulseaudio-utils"
        ],
        "postInstallScript": "scripts/debian/postinst",
        "postRemoveScript": "scripts/debian/postrm"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/scripts/install-native-messaging.sh": "scripts/macos/install-native-messaging.sh",
        "Resources/scripts/uninstall-native-messaging.sh": "scripts/macos/uninstall-native-messaging.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  }
}
