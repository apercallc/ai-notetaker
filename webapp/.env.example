# Copy to .env for local development. On Railway, both of these are set as
# environment variables during the one-click deploy — DATABASE_URL is filled
# in automatically by the linked Postgres addon, and AUTH_TOKEN is the only
# value you're asked to provide yourself.

DATABASE_URL="postgresql://user:password@localhost:5432/ainotetaker"

# Generate a real random value for this, e.g.: openssl rand -hex 32
AUTH_TOKEN="change-me-to-a-long-random-value"

# Optional managed-hosting mode. Keep provider and Stripe secrets server-side.
MANAGED_HOSTING="false"
APP_URL="https://notes.example.com"
# Optional alternate extension origin for a fork with a different manifest
# key. The official build uses the fixed Chrome extension origin by default.
MANAGED_EXTENSION_ORIGIN="chrome-extension://jidooookkdbbbhkkdmcajnnnhhphodok"
# Optional: where the web process sends job-run requests to the worker route.
# Defaults to APP_URL. Never derived from the incoming request.
WORKER_URL=""
# The AUTH_TOKEN /api/meetings ingestion API is 404 on managed hosting unless
# this is "true" (self-hosted deployments are unaffected).
LEGACY_INGEST_ENABLED="false"
MANAGED_WORKER_TOKEN="change-me-to-another-long-random-value"
MANAGED_WORKER_POLL_MS="5000"
MANAGED_WORKER_ERROR_BACKOFF_MS="10000"
MANAGED_DEEPGRAM_API_KEY=""
MANAGED_ANTHROPIC_API_KEY=""
MANAGED_SUMMARY_MODEL="claude-sonnet-5"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_HOSTED_PRO=""
STRIPE_PRICE_HOSTED_TEAM=""
# Local fallback storage for self-hosted/Docker. Managed hosting REQUIRES
# S3_BUCKET (it is part of the managed readiness check); set S3_BUCKET and server-side S3 credentials instead.
OBJECT_STORAGE_DIR=".data/objects"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX="ai-notetaker"

# Optional project-owned Google Calendar + Drive connection for the managed
# service. These values are server-only; never put them in the extension.
# In Google Cloud, register https://ai-notetaker.apercallc.com/api/google/oauth/callback as the redirect URI.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
GOOGLE_OAUTH_ENCRYPTION_KEY=""

# Optional Sentry error reporting. Unset (the default) means zero telemetry:
# nothing initializes, nothing is captured, no outbound call is made. The
# project-operated managed service sets these; self-hosted builds need not.
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are usually the same value; the
# NEXT_PUBLIC_ one must be present at build time for browser reporting.
# Releases are tagged automatically from RAILWAY_GIT_COMMIT_SHA.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="managed"
SENTRY_SAMPLE_RATE="1"
SENTRY_TRACES_SAMPLE_RATE="0"
