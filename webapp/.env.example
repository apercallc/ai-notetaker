# Copy to .env for local development. On Railway, both of these are set as
# environment variables during the one-click deploy — DATABASE_URL is filled
# in automatically by the linked Postgres addon, and AUTH_TOKEN is the only
# value you're asked to provide yourself.

DATABASE_URL="postgresql://user:password@localhost:5432/ainotetaker"

# Generate a real random value for this, e.g.: openssl rand -hex 32
AUTH_TOKEN="change-me-to-a-long-random-value"

# Optional dedicated credential for the read-only Aperca Admin account API.
AI_NOTETAKER_ADMIN_API_TOKEN="change-me-to-a-different-long-random-value"

# Optional managed-hosting mode. Keep provider and Stripe secrets server-side.
MANAGED_HOSTING="false"
APP_URL="https://notes.example.com"
# Optional alternate extension origin for a fork with a different manifest
# key. The official build uses the fixed Chrome extension origin by default.
MANAGED_EXTENSION_ORIGIN="chrome-extension://jidooookkdbbbhkkdmcajnnnhhphodok"
# Optional: where the web process sends job-run requests to the worker route.
# Defaults to APP_URL. Never derived from the incoming request.
WORKER_URL=""
# The AUTH_TOKEN /api/meetings ingestion API is 404 on managed hosting unless
# this is "true" (self-hosted deployments are unaffected).
LEGACY_INGEST_ENABLED="false"
# Hosted AI (project-run transcription, summaries, imports, Ask your notes) is
# off by default: the subscription sells cloud sync and team sync. Set to
# "true" only to re-enable those features.
HOSTED_AI_ENABLED="false"
MANAGED_WORKER_TOKEN="change-me-to-another-long-random-value"
MANAGED_WORKER_POLL_MS="5000"
MANAGED_WORKER_ERROR_BACKOFF_MS="10000"
# Default low-cost hosted pipeline: Groq Whisper Turbo + OpenAI GPT-6 Luna.
# Groq does not diarize voices; remote participants share the "Them" label.
MANAGED_TRANSCRIPTION_PROVIDER="groq"
MANAGED_GROQ_API_KEY=""
# Optional alternative: deepgram (Nova-3, diarized; higher cost).
MANAGED_DEEPGRAM_API_KEY=""
# Optional: provider for imported audio/video files. Defaults to
# MANAGED_TRANSCRIPTION_PROVIDER. "deepgram" labels speakers on a mixed track.
# Import also needs ffmpeg + ffprobe on PATH (the Docker image includes them).
MANAGED_IMPORT_TRANSCRIPTION_PROVIDER=""
# Encrypts stored integration secrets (32 random bytes, base64). Required when
# MANAGED_HOSTING=true; self-hosted instances default to a key derived from AUTH_TOKEN. See docs/integrations.md.
INTEGRATIONS_ENCRYPTION_KEY=""
# Self-hosted only (ignored on managed hosting): allow webhook targets on private networks (also permits http).
INTEGRATIONS_ALLOW_PRIVATE_NETWORKS="false"
MANAGED_SUMMARY_PROVIDER="openai"
MANAGED_OPENAI_API_KEY=""
# Optional alternative: anthropic (defaults to Claude Sonnet 5).
MANAGED_ANTHROPIC_API_KEY=""
# Optional model override; defaults based on MANAGED_SUMMARY_PROVIDER.
MANAGED_SUMMARY_MODEL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_HOSTED_PRO=""
STRIPE_PRICE_HOSTED_TEAM=""
# Local fallback storage for self-hosted/Docker. Managed audio is staged in a
# shared private R2 or S3-compatible bucket only while processing; never as
# retained meeting media. Workers delete successful uploads; failure/abandonment
# cleanup expires staging after 24 hours.
OBJECT_STORAGE_DIR=".data/objects"
# Optional Cloudflare R2 backend. Use a bucket-scoped server token.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PREFIX="ai-notetaker"
R2_ENDPOINT=""

# Existing S3-compatible backend; also valid for managed temporary staging.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX="ai-notetaker"

# Optional project-owned Google sign-in ("Continue with Google") and Calendar +
# Drive connection for the managed service (docs/launch/google-oauth.md). These values are server-only; never put them in the extension.
# In Google Cloud, register https://ai-notetaker.apercallc.com/api/google/oauth/callback as the redirect URI.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Exactly 32 random bytes, base64 encoded: openssl rand -base64 32
GOOGLE_OAUTH_ENCRYPTION_KEY=""

# Optional Sentry error reporting. Unset (the default) means zero telemetry:
# nothing initializes, nothing is captured, no outbound call is made. The
# project-operated managed service sets these; self-hosted builds need not.
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are usually the same value; the
# NEXT_PUBLIC_ one must be present at build time for browser reporting.
# Releases are tagged automatically from RAILWAY_GIT_COMMIT_SHA.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="managed"
SENTRY_SAMPLE_RATE="1"
SENTRY_TRACES_SAMPLE_RATE="0"

# --- Email (required for public sign-up on managed hosting) ---------------
# Verification, password-reset and invitation mail. Configure ONE transport.
EMAIL_FROM="AI Notetaker <noreply@notes.example.com>"
RESEND_API_KEY=""
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# Shown on the privacy and terms pages as the contact address. Set it for any
# public deployment; Google OAuth verification expects one.
SUPPORT_EMAIL=""
# Optional: jurisdiction for the terms' governing-law clause, e.g. "the State of Texas".
# The clause is omitted while this is unset.
GOVERNING_LAW=""
# Optional price text on the plans page when Stripe's price cannot be fetched.
HOSTED_PRO_PRICE_LABEL=""
HOSTED_TEAM_PRICE_LABEL=""
# Operators without email delivery may knowingly allow unverified sign-up.
ALLOW_UNVERIFIED_SIGNUP="false"
# Trusted local networks served over plain http only.
INSECURE_COOKIES="false"

# --- Worker service (Railway) ---------------------------------------------
# Where the separate worker service reaches the web app. Required on Railway.
MANAGED_WORKER_WEBAPP_URL=""

# --- Scale and cost controls ----------------------------------------------
# Required for production managed hosting; integer USD micro-dollars
# ($1 = 1,000,000). Empty values fail closed. Set these intentionally from
# your pilot budget; zero pauses new spend. Limits are shared across replicas.
MANAGED_DAILY_SPEND_MICROS=""
MANAGED_WORKSPACE_DAILY_SPEND_MICROS=""
MANAGED_TRIAL_DAILY_SPEND_MICROS=""
MANAGED_TRIAL_DAILY_GRANTS=""
# Global concurrent processing jobs, not per process (each can use 2 channels).
MANAGED_WORKER_CONCURRENCY="2"
# Existing workers run bounded cleanup between jobs; no extra service needed.
# Set false only when a dedicated cleaner or reliable scheduler is running.
MANAGED_WORKER_MAINTENANCE="true"
DATABASE_POOL_MAX="5"
# Standalone worker and cleaner need the SAME database/storage/encryption
# configuration as web. Legacy HTTP execution requires explicit opt-in.
MANAGED_WORKER_MODE="standalone"
# Enable only after bucket CORS/conditional PUT proof; see the rollout guide.
MANAGED_DIRECT_UPLOADS="false"
MANAGED_OBJECT_UPLOAD_ORIGIN=""
# Overrides are required when selecting a custom summary/chat model in production.
# These are micro-dollars PER TOKEN, not prices per million tokens.
MANAGED_OPENAI_INPUT_MICROS_PER_TOKEN=""
MANAGED_OPENAI_OUTPUT_MICROS_PER_TOKEN=""
MANAGED_ANTHROPIC_INPUT_MICROS_PER_TOKEN=""
MANAGED_ANTHROPIC_OUTPUT_MICROS_PER_TOKEN=""
