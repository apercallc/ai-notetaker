# Copy to .env for local development. On Railway, both of these are set as
# environment variables during the one-click deploy — DATABASE_URL is filled
# in automatically by the linked Postgres addon, and AUTH_TOKEN is the only
# value you're asked to provide yourself.

DATABASE_URL="postgresql://user:password@localhost:5432/ainotetaker"

# Generate a real random value for this, e.g.: openssl rand -hex 32
AUTH_TOKEN="change-me-to-a-long-random-value"

# Optional managed-hosting mode. Keep provider and Stripe secrets server-side.
MANAGED_HOSTING="false"
APP_URL="https://notes.example.com"
# Optional alternate extension origin for a fork with a different manifest
# key. The official build uses the fixed Chrome extension origin by default.
MANAGED_EXTENSION_ORIGIN="chrome-extension://jidooookkdbbbhkkdmcajnnnhhphodok"
MANAGED_WORKER_TOKEN="change-me-to-another-long-random-value"
MANAGED_WORKER_POLL_MS="5000"
MANAGED_WORKER_ERROR_BACKOFF_MS="10000"
MANAGED_DEEPGRAM_API_KEY=""
MANAGED_ANTHROPIC_API_KEY=""
MANAGED_SUMMARY_MODEL="claude-3-5-sonnet-latest"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_HOSTED_PRO=""
STRIPE_PRICE_HOSTED_TEAM=""
# Local fallback storage for self-hosted/Docker. For multi-instance managed
# hosting, set S3_BUCKET and server-side S3 credentials instead.
OBJECT_STORAGE_DIR=".data/objects"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX="ai-notetaker"
