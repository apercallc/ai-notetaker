# Copy to .env for local development. On Railway, both of these are set as
# environment variables during the one-click deploy — DATABASE_URL is filled
# in automatically by the linked Postgres addon, and AUTH_TOKEN is the only
# value you're asked to provide yourself.

DATABASE_URL="postgresql://user:password@localhost:5432/ainotetaker"

# Generate a real random value for this, e.g.: openssl rand -hex 32
AUTH_TOKEN="change-me-to-a-long-random-value"
