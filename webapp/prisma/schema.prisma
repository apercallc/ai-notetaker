// AI Notetaker webapp schema.
//
// Legacy ingestion models retain userId/workspaceId while browser UI auth uses
// real per-user sessions and workspace memberships. The deploy-time
// AUTH_TOKEN remains the separate trusted ingestion contract for self-hosted
// helper/API clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Meeting {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String?
  title       String
  mode        String    @default("general")
  startedAt   DateTime
  endedAt     DateTime
  summary     String    @db.Text
  captureSource String  @default("desktop")
  processingMode String @default("local_byok")
  recordingObjectKey String?
  // Times notes were regenerated from the stored transcript (each is a paid summary call).
  notesRegenerations Int @default(0)
  // Library placement. Null folderId is the top level.
  folderId    String?
  // Trash: a note with deletedAt set is hidden everywhere until restored or
  // purged. trashRootId names the item (a folder or this note) whose deletion
  // took it, so restoring a folder brings back exactly what went with it.
  deletedAt   DateTime?
  trashRootId String?
  // Set when the user edits the note body by hand; the replaced text is kept
  // once in previousSummary so an edit or a regeneration can be undone.
  summaryEditedAt DateTime?
  previousSummary String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transcript  TranscriptSegment[]
  actionItems ActionItem[]
  uploads     ManagedUpload[]
  processingJobs ProcessingJob[]
  shareTokens MeetingShareToken[]
  speakers    MeetingSpeaker[]
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, folderId, startedAt])
  @@index([workspaceId, deletedAt])
  @@index([userId, startedAt])
  @@index([workspaceId, startedAt])
}

model TranscriptSegment {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  speaker   String
  text      String   @db.Text
  timestamp DateTime
  order     Int

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, order])
}

model ActionItem {
  id        String  @id @default(uuid())
  meetingId String
  userId    String
  text      String  @db.Text
  owner     String?
  status    String   @default("open")
  dueAt     DateTime?
  completedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId, status, dueAt])
}

// Real per-person browser-UI auth, added alongside (not replacing) the
// single deploy-time AUTH_TOKEN, which still gates the /api/* ingestion
// contract the desktop helper uses. See
// docs/superpowers/specs/2026-09-22-webapp-multi-user-auth-design.md.

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Null until the mailbox is proven (verification link, password reset,
  // invite acceptance) or vouched for by an operator/owner who provisioned it.
  emailVerifiedAt DateTime?
  // Set when an owner issues a temporary password; cleared by the next
  // successful password change.
  mustChangePassword Boolean @default(false)
  // Created by a workspace owner who typed the address; the mailbox holder never
  // proved it, so Google sign-in refuses to attach to this account.
  ownerProvisioned Boolean @default(false)
  // Recorded at self-service signup: explicit ToS / recording-consent tick.
  termsAcceptedAt DateTime?
  termsVersion    String?

  memberships WorkspaceMembership[]
  sessions    Session[]
  apiTokens   ApiToken[]
  authTokens  AuthToken[]
  googleOAuthConnection GoogleOAuthConnection?
}

// Project-owned Google OAuth is person-scoped, not workspace-scoped. Tokens
// are AES-256-GCM ciphertexts; plaintext credentials never enter Prisma.
model GoogleOAuthConnection {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  accountEmail           String?
  accessTokenCiphertext  String   @db.Text
  refreshTokenCiphertext String   @db.Text
  expiresAt              DateTime
  scopes                 String   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  retentionDays Int?
  createdAt DateTime @default(now())

  memberships WorkspaceMembership[]
  uploads ManagedUpload[]
  processingJobs ProcessingJob[]
  usageEntries UsageLedgerEntry[]
  subscription WorkspaceSubscription?
  shareTokens MeetingShareToken[]
  auditEvents AuditEvent[]
  folders     Folder[]

  // Exactly one workspace has isDefault = true — the ingestion target for
  // every meeting synced via the AUTH_TOKEN Bearer contract, and the
  // workspace the first bootstrapped user automatically owns.
  @@index([isDefault])
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  userAgent String?
  ip        String?
  // Workspace chosen with the workspace switcher; validated against
  // membership on every request, so a stale value can never grant access.
  activeWorkspaceId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ManagedUpload {
  id             String   @id @default(uuid())
  workspaceId    String
  meetingId      String
  idempotencyKey String
  totalChunks    Int
  totalBytes     Int
  status         String   @default("created")
  objectKey      String?
  // "capture" is live mic/speaker PCM; "import" is one user-supplied audio or
  // video file that the worker decodes before transcription.
  kind           String   @default("capture")
  sourceFormat   String?
  // Client-measured duration of an imported file. Only an estimate for the
  // first usage reservation; the worker's probe is authoritative.
  declaredDurationSeconds Int?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  chunks    UploadChunk[]
  jobs      ProcessingJob[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, meetingId])
  @@index([expiresAt, id])
}

model UploadChunk {
  id        String   @id @default(uuid())
  uploadId  String
  chunkIndex Int
  channel   String   @default("speaker")
  byteLength Int
  checksum  String
  objectKey String
  createdAt DateTime @default(now())

  upload ManagedUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, chunkIndex])
}

model ProcessingJob {
  id             String   @id @default(uuid())
  workspaceId    String
  meetingId      String
  uploadId       String
  idempotencyKey String
  status         String   @default("queued")
  // Coarse progress label for imports ("decoding", "transcribing", "summarizing").
  stage          String?
  errorMessage   String?  @db.Text
  providerCostMicros Int  @default(0)
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  leaseToken     String?
  // Times a worker has claimed this job; stalled jobs stop being reclaimed at the cap.
  attempts       Int      @default(0)
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  upload    ManagedUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@unique([uploadId])
  @@index([workspaceId, status, createdAt])
  // Global workers poll across workspaces, unlike workspace status pages.
  @@index([status, createdAt])
  @@index([status, startedAt, attempts])
}

model UsageLedgerEntry {
  id             String   @id @default(uuid())
  workspaceId    String
  periodStart    DateTime
  kind           String
  units          Int
  // Two-channel-equivalent audio time reserved with this unit; caps provider cost.
  audioSeconds   Int      @default(0)
  idempotencyKey String
  releasedAt     DateTime?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, periodStart, kind])
}

model WorkspaceSubscription {
  id                   String   @id @default(uuid())
  workspaceId          String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  plan                 String   @default("local")
  status               String   @default("inactive")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  graceEndsAt           DateTime?
  lastBillingEventCreatedAt Int?
  // Set while an owner has an uncompleted Stripe Checkout; never touches "status".
  checkoutClaimedAt    DateTime?
  // The open Stripe Checkout Session behind the claim, so a retry can expire it.
  checkoutSessionId    String?
  // Set while Stripe has a pending cancellation; access lasts until then.
  cancelsAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MeetingShareToken {
  id          String   @id @default(uuid())
  workspaceId String
  meetingId   String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, meetingId])
}

model BillingEvent {
  id          String   @id
  type        String
  eventCreatedAt Int?
  processedAt DateTime @default(now())
}

// Shared failed-login budget for managed hosting. Keeping this in Postgres
// makes the throttle effective across web replicas and survives a deploy.
model LoginThrottle {
  emailKey       String   @id
  failures       Int      @default(0)
  firstFailureAt DateTime
  updatedAt      DateTime @updatedAt

  @@index([firstFailureAt])
}

// Bearer credential for the browser extension / managed clients. Only the
// SHA-256 of the secret is stored, so a database leak does not yield usable
// tokens. Expiry is sliding (renewed while in use) and every token is
// individually revocable from /account.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  scope      String    @default("managed")
  label      String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use, expiring, hashed tokens emailed (or handed to an owner) for
// email verification, password reset and workspace invitations. `email` is
// the normalized target address; `workspaceId` is intentionally not a
// relation so this table stays independent of the tenant models.
model AuthToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  purpose     String
  userId      String?
  email       String
  workspaceId String?
  role        String?
  invitedById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([workspaceId, purpose])
  @@index([expiresAt])
}

// Append-only trail of who changed what in a workspace. Holds ids and small,
// non-sensitive facts only: never transcript or note text, secrets or tokens
// (see lib/audit.ts, which enforces this). Purged after AUDIT_RETENTION_DAYS.
model AuditEvent {
  id          String   @id @default(uuid())
  workspaceId String
  // Null for system actions (retention sweeps, background jobs).
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([createdAt])
}

// A person-chosen name for one speaker of one meeting. The transcript keeps its
// stable keys ("you", "them-1", "speaker-2"); this table only maps a key to the
// name shown everywhere. `appliedLabel` is the exact text currently written
// into the summary and action items for that speaker, so the next rename
// replaces precisely that text.
model MeetingSpeaker {
  id           String   @id @default(uuid())
  meetingId    String
  speakerKey   String
  displayName  String
  appliedLabel String
  updatedAt    DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, speakerKey])
}

// A library folder. Folders nest (depth is capped in lib/library.ts) and hold
// notes; they are workspace-wide, like the notes themselves. Names are unique
// per parent ignoring case among live folders (a partial unique index created
// in the migration, which Prisma cannot express). Deleting a folder trashes it
// together with everything inside; see Meeting.trashRootId.
model Folder {
  id              String    @id @default(uuid())
  workspaceId     String
  parentId        String?
  name            String
  createdByUserId String?
  deletedAt       DateTime?
  trashRootId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  meetings  Meeting[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, deletedAt])
}
