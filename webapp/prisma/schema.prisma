// AI Notetaker webapp schema.
//
// Legacy ingestion models retain userId/workspaceId while browser UI auth uses
// real per-user sessions and workspace memberships. The deploy-time
// AUTH_TOKEN remains the separate trusted ingestion contract for self-hosted
// helper/API clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String?
  title       String
  mode        String    @default("general")
  startedAt   DateTime
  endedAt     DateTime
  summary     String    @db.Text
  captureSource String  @default("desktop")
  processingMode String @default("local_byok")
  recordingObjectKey String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transcript  TranscriptSegment[]
  actionItems ActionItem[]
  uploads     ManagedUpload[]
  processingJobs ProcessingJob[]
  shareTokens MeetingShareToken[]

  @@index([userId, startedAt])
}

model TranscriptSegment {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  speaker   String
  text      String   @db.Text
  timestamp DateTime
  order     Int

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, order])
}

model ActionItem {
  id        String  @id @default(uuid())
  meetingId String
  userId    String
  text      String  @db.Text
  owner     String?
  status    String   @default("open")
  dueAt     DateTime?
  completedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId, status, dueAt])
}

// Real per-person browser-UI auth, added alongside (not replacing) the
// single deploy-time AUTH_TOKEN, which still gates the /api/* ingestion
// contract the desktop helper uses. See
// docs/superpowers/specs/2026-09-22-webapp-multi-user-auth-design.md.

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships WorkspaceMembership[]
  sessions    Session[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  retentionDays Int?
  createdAt DateTime @default(now())

  memberships WorkspaceMembership[]
  uploads ManagedUpload[]
  processingJobs ProcessingJob[]
  usageEntries UsageLedgerEntry[]
  subscription WorkspaceSubscription?
  shareTokens MeetingShareToken[]

  // Exactly one workspace has isDefault = true — the ingestion target for
  // every meeting synced via the AUTH_TOKEN Bearer contract, and the
  // workspace the first bootstrapped user automatically owns.
  @@index([isDefault])
}

model WorkspaceMembership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ManagedUpload {
  id             String   @id @default(uuid())
  workspaceId    String
  meetingId      String
  idempotencyKey String
  totalChunks    Int
  totalBytes     Int
  status         String   @default("created")
  objectKey      String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  chunks    UploadChunk[]
  jobs      ProcessingJob[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, meetingId])
}

model UploadChunk {
  id        String   @id @default(uuid())
  uploadId  String
  chunkIndex Int
  channel   String   @default("speaker")
  byteLength Int
  checksum  String
  objectKey String
  createdAt DateTime @default(now())

  upload ManagedUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, chunkIndex])
}

model ProcessingJob {
  id             String   @id @default(uuid())
  workspaceId    String
  meetingId      String
  uploadId       String
  idempotencyKey String
  status         String   @default("queued")
  errorMessage   String?  @db.Text
  providerCostMicros Int  @default(0)
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  leaseToken     String?
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  upload    ManagedUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
}

model UsageLedgerEntry {
  id             String   @id @default(uuid())
  workspaceId    String
  periodStart    DateTime
  kind           String
  units          Int
  idempotencyKey String
  releasedAt     DateTime?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, periodStart, kind])
}

model WorkspaceSubscription {
  id                   String   @id @default(uuid())
  workspaceId          String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  plan                 String   @default("local")
  status               String   @default("inactive")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  graceEndsAt           DateTime?
  lastBillingEventCreatedAt Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MeetingShareToken {
  id          String   @id @default(uuid())
  workspaceId String
  meetingId   String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, meetingId])
}

model BillingEvent {
  id          String   @id
  type        String
  eventCreatedAt Int?
  processedAt DateTime @default(now())
}

// Shared failed-login budget for managed hosting. Keeping this in Postgres
// makes the throttle effective across web replicas and survives a deploy.
model LoginThrottle {
  emailKey       String   @id
  failures       Int      @default(0)
  firstFailureAt DateTime
  updatedAt      DateTime @updatedAt

  @@index([firstFailureAt])
}
