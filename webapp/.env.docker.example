# Copy to .env before `docker compose up -d --build`.
POSTGRES_USER=notetaker
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=ainotetaker
AUTH_TOKEN=replace-with-a-long-url-safe-token

# Optional managed processing and billing. Leave blank for local/BYOK-only use.
APP_URL=https://notes.example.com
# Leave at the official value unless the extension manifest key is changed in
# a controlled fork.
MANAGED_EXTENSION_ORIGIN=chrome-extension://jidooookkdbbbhkkdmcajnnnhhphodok
MANAGED_WORKER_TOKEN=replace-with-another-long-url-safe-token
MANAGED_WORKER_POLL_MS=5000
MANAGED_WORKER_ERROR_BACKOFF_MS=10000
MANAGED_DEEPGRAM_API_KEY=
MANAGED_ANTHROPIC_API_KEY=
MANAGED_SUMMARY_MODEL=claude-3-5-sonnet-latest
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOSTED_PRO=
STRIPE_PRICE_HOSTED_TEAM=
OBJECT_STORAGE_DIR=/app/.data/objects
# Optional S3-compatible storage for multi-instance managed hosting. Leave
# these blank to use the persistent Docker volume above.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=ai-notetaker

# Keep the service private by default. Set 0.0.0.0 only when you have
# configured HTTPS and network access controls in front of the webapp.
AI_NOTETAKER_WEBAPP_BIND=127.0.0.1
AI_NOTETAKER_WEBAPP_PORT=3000
MANAGED_HOSTING=false
