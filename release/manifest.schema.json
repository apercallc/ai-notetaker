{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apercallc.github.io/ai-notetaker/release/manifest.schema.json",
  "title": "AI Notetaker release manifest",
  "type": "object",
  "required": ["schemaVersion", "product", "version", "status", "extension", "protocol", "artifacts"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" } }, "required": ["status"] },
      "then": {
        "properties": {
          "extension": {
            "anyOf": [
              { "required": ["chromeWebStoreUrl"], "properties": { "chromeWebStoreUrl": { "type": "string", "format": "uri", "pattern": "^https://(chromewebstore\\.google\\.com|chrome\\.google\\.com)/.*?/detail/" } } },
              { "required": ["fallbackZipUrl"], "properties": { "fallbackZipUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/.*/releases/download/.*/ai-notetaker-extension-.+\\.zip$" } } }
            ]
          },
          "artifacts": {
            "allOf": [
              { "contains": { "properties": { "platform": { "const": "macos" }, "architecture": { "const": "arm64" }, "format": { "const": "dmg" } }, "required": ["platform", "architecture", "format"] } },
              { "contains": { "properties": { "platform": { "const": "macos" }, "architecture": { "const": "x86_64" }, "format": { "const": "dmg" } }, "required": ["platform", "architecture", "format"] } },
              { "contains": { "properties": { "platform": { "const": "windows" }, "format": { "const": "nsis" } }, "required": ["platform", "format"] } },
              { "contains": { "properties": { "platform": { "const": "linux" }, "format": { "const": "deb" } }, "required": ["platform", "format"] } }
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "ai-notetaker" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["unpublished", "published"] },
    "extension": {
      "type": "object",
      "required": ["version", "id", "chromeWebStoreUrl", "fallbackZipUrl"],
      "properties": {
        "version": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-p]{32}$" },
        "chromeWebStoreUrl": { "type": ["string", "null"], "format": "uri" },
        "fallbackZipUrl": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["version", "minimumSupported"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "minimumSupported": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "architecture", "format", "url", "sha256", "signatureStatus"],
        "properties": {
          "platform": { "enum": ["macos", "windows", "linux"] },
          "architecture": { "enum": ["arm64", "x86_64", "universal", "amd64"] },
          "format": { "enum": ["dmg", "pkg", "msi", "nsis", "deb", "appimage"] },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signatureStatus": { "enum": ["unsigned", "signed", "notarized", "signed_and_notarized"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
