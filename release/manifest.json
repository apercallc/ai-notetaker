    "chocolatey": {
      "installCommand": "choco install ai-notetaker",
      "updateCommand": "choco upgrade ai-notetaker"
    }
  },
  "docker": {
    "composeFile": "webapp/docker-compose.yml",
    "scope": "history-webapp-only"
  }
