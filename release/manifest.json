{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "product": "ai-notetaker",
  "version": "0.1.0",
  "status": "unpublished",
  "extension": {
    "version": "0.1.0",
    "id": "jidooookkdbbbhkkdmcajnnnhhphodok",
    "chromeWebStoreUrl": null,
    "fallbackZipUrl": null
  },
  "protocol": {
    "version": 3,
    "minimumSupported": 3
  },
  "artifacts": [],
  "packageManagers": {
    "homebrew": {
      "installCommand": "brew install --cask ai-notetaker",
      "updateCommand": "brew upgrade --cask ai-notetaker"
