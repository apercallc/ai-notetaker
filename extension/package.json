{
  "name": "ai-notetaker-extension",
  "version": "0.1.0",
  "description": "AI Notetaker Chrome extension — botless meeting notes with local BYOK or optional hosted AI.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
